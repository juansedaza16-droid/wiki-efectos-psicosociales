<script>
function showTab(btn,which){const art=btn.closest('.topic');art.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));btn.classList.add('active');art.querySelectorAll('.tab-content').forEach(x=>x.classList.add('hidden'));art.querySelector('.tab-content.'+which).classList.remove('hidden')}
function toggleSaved(btn){btn.classList.toggle('saved');btn.textContent=btn.classList.contains('saved')?'★ Guardado':'☆ Guardar';btn.style.background=btn.classList.contains('saved')?'#d8f3e5':'#edf4ff'}
let answered=new Set();
function checkQuiz(btn,correct){const art=btn.closest('.topic');const radios=art.querySelectorAll('input[type=radio]');let selected=-1;radios.forEach(r=>{if(r.checked)selected=Number(r.value)});const feedback=art.querySelector('.feedback');if(selected<0){feedback.textContent='Selecciona una respuesta antes de comprobar.';feedback.style.color='#8a5b00';return}const id=art.id;answered.add(id);if(selected===correct){feedback.textContent='¡Correcto! La prevención requiere actuar sobre las condiciones de trabajo.';feedback.style.color='#1e7651'}else{feedback.textContent='No exactamente. Revisa la sección “Prevención y actuación” y vuelve a intentarlo.';feedback.style.color='#9b2c2c'}document.getElementById('score').textContent='Cuestionarios: '+answered.size+'/9 respondidos';document.getElementById('progress').style.width=(answered.size/9*100)+'%'}
const search=document.getElementById('search'),arts=[...document.querySelectorAll('.topic')],count=document.getElementById('count');
function filter(){const q=search.value.trim().toLowerCase();let n=0;arts.forEach(a=>{const ok=!q||a.innerText.toLowerCase().includes(q);a.classList.toggle('hidden',!ok);if(ok)n++});count.textContent=n+' de 9 temas visibles.'}
search.addEventListener('input',filter);document.getElementById('clear').addEventListener('click',()=>{search.value='';filter();search.focus()});
function makePlan(){const f=document.getElementById('phenom').value,a=document.getElementById('action').value.trim(),o=document.getElementById('owner').value.trim(),i=document.getElementById('indicator').value.trim();const box=document.getElementById('planout');box.classList.remove('hidden');box.innerHTML='<strong>Plan de acción — '+f+'</strong><br><b>Acción:</b> '+(a||'Por definir')+'<br><b>Responsables:</b> '+(o||'Por definir')+'<br><b>Indicador/seguimiento:</b> '+(i||'Por definir');}
</script></body></html>
